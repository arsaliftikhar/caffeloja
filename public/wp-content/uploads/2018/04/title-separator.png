<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 160 20" width="160" height="20" fill="none">
  <!-- Left tapered line -->
  <path d="M10 10 L60 10" stroke="#e69d45" stroke-width="1.5" stroke-linecap="round" opacity="0.6"/>
  <circle cx="64" cy="10" r="1.5" fill="#e69d45"/>
  
  <!-- Center Coffee Bean Ornament -->
  <g transform="translate(80, 10)">
    <!-- Bean outer contour -->
    <path d="M-9,-7 C-3,-9 3,-9 9,-7 C12,-3 12,3 9,7 C3,9 -3,9 -9,7 C-12,3 -12,-3 -9,-7 Z" fill="#e69d45" opacity="0.9"/>
    <!-- Bean center curve (crease) -->
    <path d="M-6,-5 Q0,-1 0,0 Q0,1 6,5" stroke="#140e0a" stroke-width="1.2" stroke-linecap="round" fill="none"/>
  </g>
  
  <!-- Right tapered line -->
  <circle cx="96" cy="10" r="1.5" fill="#e69d45"/>
  <path d="M100 10 L150 10" stroke="#e69d45" stroke-width="1.5" stroke-linecap="round" opacity="0.6"/>
</svg>
