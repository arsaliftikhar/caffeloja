    /**
     * @return void
     */
    function acemero_validate_membership_cart() {
        if (is_admin() && !defined('DOING_AJAX')) {
            return;
        }

        $has_membership = false;
        $has_product = false;

        // Loop through cart
        foreach (WC()->cart->get_cart() as $cart_item) {
            $product_id = $cart_item['product_id'];
            $categories = wp_get_post_terms($product_id, 'product_cat', ['fields' => 'slugs']);

            if (in_array('membership', $categories)) {
                $has_membership = true;
            }

            if (in_array('products', $categories)) {
                $has_product = true;
            }
        }

        // Clear old notices
        wc_clear_notices();

        // Restrict logged-in users from buying membership
        if (is_user_logged_in() && $has_membership) {
            wc_add_notice(
                __('Logged-in users cannot purchase membership products. Please log out to continue.', 'woocommerce'),
                'error'
            );
            return;
        }

        // Prevent checkout if only membership product in cart
        if ($has_membership && !$has_product) {
            wc_add_notice(
                __('You cannot purchase a membership product only. Please add at least one product from the Products category.', 'woocommerce'),
                'error'
            );
        }
    }

