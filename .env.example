# MongoDB Connection String
# For local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/caffeloja
# For MongoDB Atlas (replace <username>, <password>, and <cluster-url>):
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>.mongodb.net/caffeloja?retryWrites=true&w=majority

MONGODB_DB=caffeloja
NEXT_PUBLIC_APP_NAME="caffeloja"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# WooCommerce Dropshipping REST API
WC_ORDERS_API_URL=https://roastery-partner.example.com/wp-json/wc/v3/orders
WC_CONSUMER_KEY=ck_your_woocommerce_consumer_key
WC_CONSUMER_SECRET=cs_your_woocommerce_consumer_secret

# Resend Email Delivery (resend.com)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=Caffeloja <onboarding@resend.dev>
