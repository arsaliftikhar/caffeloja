# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>.mongodb.net/caffeloja?retryWrites=true&w=majority

MONGODB_DB=caffeloja
NEXT_PUBLIC_APP_NAME="Caffè Loja"
